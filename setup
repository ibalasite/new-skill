#!/usr/bin/env bash
# new-skill setup — install / update / uninstall
# Usage:
#   ./setup             # install (default)
#   ./setup install
#   ./setup update
#   ./setup uninstall

set -e

REPO_URL="https://github.com/ibalasite/new-skill.git"
RUNTIME_DIR="$HOME/.claude/skills/new-skill"
SKILLS_SRC="$RUNTIME_DIR/skills"
CLAUDE_SKILLS_DIR="$HOME/.claude/skills"

CMD="${1:-install}"

log() { echo "[new-skill] $*"; }
die() { echo "[new-skill] ERROR: $*" >&2; exit 1; }

check_deps() {
  command -v git >/dev/null 2>&1 || die "git is required"
}

deploy_skills() {
  [[ -d "$SKILLS_SRC" ]] || return
  for skill_dir in "$SKILLS_SRC"/*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    rm -rf "$CLAUDE_SKILLS_DIR/$name"
    cp -r "$skill_dir" "$CLAUDE_SKILLS_DIR/$name"
    log "  · deployed ~/.claude/skills/$name"
  done
}

remove_skills() {
  [[ -d "$SKILLS_SRC" ]] || return
  for skill_dir in "$SKILLS_SRC"/*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    if [[ -d "$CLAUDE_SKILLS_DIR/$name" ]]; then
      rm -rf "$CLAUDE_SKILLS_DIR/$name"
      log "  · removed ~/.claude/skills/$name"
    fi
  done
}

do_install() {
  check_deps

  if [[ -d "$RUNTIME_DIR/.git" ]]; then
    log "$RUNTIME_DIR already exists — running update instead"
    do_update
    return
  fi

  log "Cloning new-skill → $RUNTIME_DIR"
  git clone "$REPO_URL" "$RUNTIME_DIR"

  deploy_skills

  log ""
  log "✓ Install complete. Restart Claude Code to activate /new-skill."
  log "  · Upgrade : /new-skill-upgrade  (or ./setup update)"
  log "  · Remove  : ./setup uninstall"
}

do_update() {
  check_deps
  [[ -d "$RUNTIME_DIR/.git" ]] || die "$RUNTIME_DIR not found. Run: ./setup install"

  log "Pulling latest..."
  git -C "$RUNTIME_DIR" pull --ff-only

  deploy_skills

  log "✓ Update complete."
}

do_uninstall() {
  if [[ -f "$RUNTIME_DIR/bin/new-skill-init.py" ]]; then
    remove_skills
  fi

  if [[ -d "$RUNTIME_DIR" ]]; then
    rm -rf "$RUNTIME_DIR"
    log "Removed $RUNTIME_DIR"
  fi

  log "✓ Uninstall complete."
}

case "$CMD" in
  install)   do_install   ;;
  update)    do_update    ;;
  uninstall) do_uninstall ;;
  *) die "Unknown command: $CMD. Use: install | update | uninstall" ;;
esac
