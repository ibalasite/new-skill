#!/usr/bin/env bash
# {{SKILL_NAME}} setup — install / update / uninstall
# Usage:
#   ./setup             # install (default)
#   ./setup install
#   ./setup update
#   ./setup uninstall

set -e

REPO_URL="https://github.com/{{GITHUB_ORG}}/{{SKILL_NAME}}.git"
RUNTIME_DIR="$HOME/.claude/skills/{{SKILL_NAME}}"
SKILLS_SRC="$RUNTIME_DIR/skills"
CLAUDE_SKILLS_DIR="$HOME/.claude/skills"
SETTINGS_HOOK="$RUNTIME_DIR/bin/{{SKILL_NAME}}-settings-hook.py"

CMD="${1:-install}"

log()  { echo "[{{SKILL_NAME}}] $*"; }
die()  { echo "[{{SKILL_NAME}}] ERROR: $*" >&2; exit 1; }

# ── prereq check ──────────────────────────────────────────────────────────────
check_deps() {
  # DEPS: {{DEPS}}
  local missing=()
  command -v git     >/dev/null 2>&1 || missing+=("git")
  command -v python3 >/dev/null 2>&1 || missing+=("python3")
  # Add more checks here based on {{DEPS}}
  if [[ ${#missing[@]} -gt 0 ]]; then
    die "Missing dependencies: ${missing[*]}"
  fi
}

# ── deploy sub-skills ─────────────────────────────────────────────────────────
deploy_skills() {
  if [[ ! -d "$SKILLS_SRC" ]]; then return; fi
  for skill_dir in "$SKILLS_SRC"/*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    rm -rf "$CLAUDE_SKILLS_DIR/$name"
    cp -r "$skill_dir" "$CLAUDE_SKILLS_DIR/$name"
    log "  · deployed ~/.claude/skills/$name"
  done
}

# ── remove deployed sub-skills ────────────────────────────────────────────────
remove_skills() {
  if [[ ! -d "$SKILLS_SRC" ]]; then return; fi
  for skill_dir in "$SKILLS_SRC"/*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    if [[ -d "$CLAUDE_SKILLS_DIR/$name" ]]; then
      rm -rf "$CLAUDE_SKILLS_DIR/$name"
      log "  · removed ~/.claude/skills/$name"
    fi
  done
}

# ── install ───────────────────────────────────────────────────────────────────
do_install() {
  check_deps

  if [[ -d "$RUNTIME_DIR/.git" ]]; then
    log "$RUNTIME_DIR already exists — running update instead"
    do_update
    return
  fi

  log "Cloning {{SKILL_NAME}} → $RUNTIME_DIR"
  git clone "$REPO_URL" "$RUNTIME_DIR"

  deploy_skills

  log "Registering hooks..."
  python3 "$SETTINGS_HOOK" add-stop
  python3 "$SETTINGS_HOOK" add-posttooluse

  log "Initialising config..."
  python3 "$RUNTIME_DIR/bin/{{SKILL_NAME}}-settings-hook.py" init-config

  log ""
  log "✓ Install complete. Restart Claude Code to activate hooks."
  log "  · Upgrade : /{{SKILL_NAME}}-upgrade  (or ./setup update)"
  log "  · Remove  : ./setup uninstall"
}

# ── update ────────────────────────────────────────────────────────────────────
do_update() {
  check_deps

  [[ -d "$RUNTIME_DIR/.git" ]] || die "$RUNTIME_DIR not found. Run: ./setup install"

  log "Pulling latest changes..."
  git -C "$RUNTIME_DIR" pull --ff-only

  deploy_skills

  log "✓ Update complete."
}

# ── uninstall ─────────────────────────────────────────────────────────────────
do_uninstall() {
  log "Removing hooks..."
  if [[ -f "$SETTINGS_HOOK" ]]; then
    python3 "$SETTINGS_HOOK" remove
  fi

  remove_skills

  if [[ -d "$RUNTIME_DIR" ]]; then
    rm -rf "$RUNTIME_DIR"
    log "Removed $RUNTIME_DIR"
  fi

  log ""
  log "✓ Uninstall complete."
  log "  Project data (.{{SKILL_NAME}}/ directories) were NOT deleted."
  log "  Remove them manually if needed."
}

# ── dispatch ──────────────────────────────────────────────────────────────────
case "$CMD" in
  install)   do_install   ;;
  update)    do_update    ;;
  uninstall) do_uninstall ;;
  *) die "Unknown command: $CMD. Use: install | update | uninstall" ;;
esac
